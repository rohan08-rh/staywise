<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staywise | Find your next stay</title>
 <link href="/styles/output.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-sand text-ink">
  <%- include('../partials/nav')  %>

  <main class="mx-auto max-w-6xl px-6 pb-20 pt-12 lg:px-8 lg:pt-20">
    <section class="grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="mb-5 text-sm font-bold uppercase tracking-[0.22em] text-coral">Stay somewhere memorable</p>
        <h1 class="max-w-2xl font-display text-5xl leading-[1.04] tracking-tight sm:text-7xl">Find a place that feels like yours.</h1>
        <p class="mt-6 max-w-lg text-lg leading-8 text-ink/65">Thoughtful homes, welcoming hosts, and the right address for your next chapter.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/homes" class="rounded-full bg-coral px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-coral/20 transition hover:-translate-y-0.5 hover:bg-[#e92f51]">Browse homes</a>
          <a href="#homes" class="rounded-full border border-ink/15 px-6 py-3.5 text-sm font-bold transition hover:border-ink/40">See what is available</a>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-[2rem] bg-[#dbe7e2] p-4 shadow-2xl shadow-ink/10 sm:p-5">
        <div class="flex min-h-[360px] flex-col justify-between rounded-[1.5rem] bg-[#78988a] p-7 text-white sm:min-h-[440px]">
          <div class="flex items-start justify-between">
            <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-bold uppercase tracking-wider backdrop-blur">Featured stay</span>
            <span class="text-2xl" aria-hidden="true">*</span>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-white/70">The Greenhouse</p>
            <h2 class="mt-2 font-display text-4xl leading-tight">Slow mornings,<br>wide open skies.</h2>
            <p class="mt-5 text-sm text-white/80">Nashik, Maharashtra <span class="mx-2">|</span> From $84 / night</p>
          </div>
        </div>
      </div>
    </section>

    <section id="why" class="mt-20 grid gap-5 border-y border-ink/10 py-8 sm:grid-cols-3">
      <div><p class="text-3xl font-bold">48k+</p><p class="mt-2 text-sm text-ink/55">homes with a human touch</p></div>
      <div><p class="text-3xl font-bold">4.9/5</p><p class="mt-2 text-sm text-ink/55">average guest rating</p></div>
      <div><p class="text-3xl font-bold">120+</p><p class="mt-2 text-sm text-ink/55">cities to wander through</p></div>
    </section>
    <section id="homes" class="mt-16">
      <div class="mb-7 flex items-end justify-between gap-5">
        <div><p class="text-sm font-bold uppercase tracking-[0.2em] text-coral">Fresh for you</p><h2 class="mt-2 font-display text-4xl">Available stays</h2></div>
        <a href="/homes" class="hidden text-sm font-bold text-coral sm:block">View all homes -></a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

  <% homes.forEach((home) => { %>

    <article class="group overflow-hidden rounded-2xl border border-ink/8 bg-white shadow-sm">

      <img
        src="<%= home.imageUrl %>"
        alt="<%= home.houseName %>"
        class="h-56 w-full object-cover"
      >

      <div class="p-5">

        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-bold uppercase tracking-widest text-coral">
            Available stay
          </p>

          <p class="text-sm font-bold">
            * <%= home.rating %>
          </p>
        </div>

        <h3 class="mt-3 font-display text-2xl">
          <%= home.houseName %>
        </h3>

        <p class="mt-1 text-sm text-ink/55">
          <%= home.location %>
        </p>

        <div class="mt-5 flex items-center justify-between gap-3">

          <p class="font-bold">
            $<%= home.price %>
            <span class="font-normal text-ink/50">
              / night
            </span>
          </p>

          <!-- DETAILS BUTTON -->
          <a
            href="/Homes/<%= home._id %>"
            style="display: inline-block; background-color: blue; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold;"
          >
            Details
          </a>

        </div>

      </div>
       <%- include('../partials/fav',{home:home})  %>

    </article>

  <% }); %>

</div>
    </section>
  </main>
</body>
</html>