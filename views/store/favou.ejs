<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explore stays | Staywise</title>
    <link href="/styles/output.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-sand text-ink">
  <%- include('../partials/nav')  %>
  <main class="mx-auto max-w-6xl px-6 pb-20 pt-12 lg:px-8 lg:pt-16">
    <header class="mb-10 flex flex-col justify-between gap-5 border-b border-ink/10 pb-8 sm:flex-row sm:items-end">
      <div><p class="text-sm font-bold uppercase tracking-[0.2em] text-coral">Staywise collection</p><h1 class="mt-3 font-display text-5xl">Explore stays</h1><p class="mt-3 max-w-xl text-ink/60">Find a welcoming home for quiet weekends, big adventures, and everything between.</p></div>
      <a href="/add-home" class="w-fit rounded-full border border-ink/15 px-5 py-3 text-sm font-bold transition hover:border-coral hover:text-coral">List your home</a>
    </header>
    <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% homes.forEach((home) => { 
        const item = home.homeId || home;
      %>
        <article class="group overflow-hidden rounded-2xl border border-ink/8 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/10">
         <div class="p-5">
          <img src="<%= item.imageUrl || '/images/default-home.jpg' %>" alt="<%= item.houseName %>" class="h-56 w-full object-cover transition duration-500 group-hover:scale-105">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-bold uppercase tracking-widest text-coral">
      Available stay
    </p>
    <p class="text-sm font-bold">* <%= item.rating %></p>
  </div>

  <h2 class="mt-3 font-display text-2xl"><%= item.houseName %></h2>
  <p class="mt-1 text-sm text-ink/55"><%= item.location %></p>

 <div class="mt-5 flex items-center justify-between">
  <p class="font-bold">
    $<%= item.price %>
    <span class="font-normal text-ink/50">/ night</span>
  </p>

  <a
    href="/Homes/<%= item._id %>"
    class="rounded-lg bg-blue-500 px-4 py-2 text-white hover:bg-blue-600"
  >
    Details
  </a>
</div>


 </article>
      <% }); %>
    </section>
  </main>


</body>
</html>



