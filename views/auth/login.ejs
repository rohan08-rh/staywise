
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in | Staywise</title>
    <link href="/styles/output.css" rel="stylesheet">
</head>

<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#fff5f1_0%,_#fffaf7_35%,_#f6f2ef_100%)] text-ink antialiased">

    <%- include('../partials/nav') %>

    <main class="relative flex min-h-[calc(100vh-80px)] items-center justify-center overflow-hidden px-4 py-12">
        <div class="absolute -left-16 top-20 h-64 w-64 rounded-full bg-[#ffd8d0] opacity-70 blur-3xl"></div>
        <div class="absolute -right-16 bottom-10 h-72 w-72 rounded-full bg-[#ffe4b8] opacity-70 blur-3xl"></div>

        <div class="relative grid w-full max-w-5xl overflow-hidden rounded-[32px] border border-white/60 bg-white/85 shadow-[0_30px_90px_-40px_rgba(15,23,42,0.35)] backdrop-blur md:grid-cols-[1.08fr_0.92fr]">

            <section class="hidden overflow-hidden bg-gradient-to-br from-[#fff3f1] via-[#fffaf7] to-[#f5efe8] p-10 lg:flex lg:flex-col lg:justify-between">
                <div>
                    <span class="inline-flex items-center rounded-full border border-coral/20 bg-white/80 px-3 py-1 text-xs font-bold uppercase tracking-[0.25em] text-coral">Staywise</span>
                    <h1 class="mt-8 max-w-sm font-display text-5xl leading-none text-ink">Find a place that feels like home.</h1>
                    <p class="mt-5 max-w-md text-lg leading-8 text-ink/60">Discover thoughtfully designed stays for work trips, weekend escapes, and the moments in between.</p>
                </div>

                <div class="space-y-4">
                    <div class="rounded-2xl border border-ink/10 bg-white/80 p-4 shadow-sm">
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Guest favorite</p>
                        <p class="mt-3 flex items-center justify-between text-sm text-ink/60">
                            <span>4.9 average rating</span>
                            <span class="rounded-full bg-coral px-2.5 py-1 text-xs font-bold text-white">Top 1%</span>
                        </p>
                    </div>

                    <div class="flex items-center gap-3 rounded-2xl border border-ink/10 bg-white/80 p-4 shadow-sm">
                        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-sm font-bold text-white">S</div>
                        <div>
                            <p class="font-bold text-ink">Sarah M.</p>
                            <p class="text-sm text-ink/55">“The host was lovely and the stay felt like a boutique hotel.”</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="p-6 sm:p-8 lg:p-10">
                <div class="mx-auto max-w-md">
                    <div class="mb-8 text-center lg:text-left">
                        <p class="text-xs font-bold uppercase tracking-[0.35em] text-coral">Welcome back</p>
                        <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink">Log in</h2>
                        <p class="mt-2 text-sm text-ink/60">Continue to your Staywise account.</p>
                    </div>

                    <% const errorList = (typeof errorMessages !== 'undefined' && errorMessages.length > 0) ? errorMessages : (typeof loginError !== 'undefined' && loginError ? [loginError] : []); %>
                    <% if (errorList.length > 0) { %>
                        <div class="mb-5 rounded-2xl border border-red-200 bg-red-50 p-4 shadow-sm" role="alert">
                            <div class="flex items-start gap-3">
                                <div class="mt-0.5 flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-600">!</div>
                                <div class="space-y-1">
                                    <p class="text-sm font-semibold text-red-700">Please check the details below.</p>
                                    <ul class="space-y-1 text-sm text-red-700">
                                        <% errorList.forEach((message) => { %>
                                            <li class="flex items-start gap-2">
                                                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-red-500"></span>
                                                <span><%= message %></span>
                                            </li>
                                        <% }); %>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <form action="/login" method="POST" class="space-y-5">
                        <div>
                            <label for="email" class="mb-2 block text-sm font-bold text-ink/70">Email address</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                                autocomplete="email"
                                class="w-full rounded-2xl border border-ink/15 bg-sand/50 px-4 py-3.5 text-ink placeholder:text-ink/30 outline-none transition focus:border-coral focus:ring-4 focus:ring-coral/10"
                            >
                        </div>

                        <div>
                            <div class="mb-2 flex items-center justify-between gap-3">
                                <label for="password" class="block text-sm font-bold text-ink/70">Password</label>
                                <a href="/forgot-password" class="text-sm font-semibold text-blue-600 visited:text-blue-600 hover:text-blue-900 transition-colors no-underline">Forgot password?</a>
                            </div>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                required
                                autocomplete="current-password"
                                class="w-full rounded-2xl border border-ink/15 bg-sand/50 px-4 py-3.5 text-ink placeholder:text-ink/30 outline-none transition focus:border-coral focus:ring-4 focus:ring-coral/10"
                            >
                        </div>

                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="remember" name="remember" class="h-4 w-4 rounded border-ink/20 text-coral focus:ring-coral/20">
                            <label for="remember" class="text-sm text-ink/60">Remember me</label>
                        </div>

                        <button type="submit" class="w-full rounded-full bg-coral px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-coral/20 transition hover:-translate-y-0.5 hover:bg-[#e92f51]">
                            Log in
                        </button>
                    </form>
                      <div class="my-7 flex items-center gap-4">
                        <div class="h-px flex-1 bg-ink/10"></div>
                        <span class="text-sm text-ink/40">or</span>
                        <div class="h-px flex-1 bg-ink/10"></div>
                    </div>
                  

                    <p class="mt-8 text-center text-sm text-ink/60">
                        Don’t have an account?
                        <a href="/signup" class="font-bold text-coral transition hover:text-[#e92f51]">Sign up</a>
                    </p>
                </div>
            </section>
        </div>
    </main>

</body>
</html>


